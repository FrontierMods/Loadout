[
  {
    id: "mount/rail/magpul",
    inherit: ["@gunmod", "@mod_target/long_guns"],
    type: "ITEM",
    subtypes: ["GUNMOD"],

    /*
        SOURCES
            https://magpul.com/m-lokaluminumrail-9slots.html

            https://magpul.com/m-lok
                - height reference

            https://www.aawee.fi/en/parts-and-accessories/magpul-m-lok-rail-section-9-slot-picatinny-rail/p/MAG583-BLK/
                - weight
                - width reference
     */

    /*
        NOTES
            - the 9-slot/4.1-inch version
     */

    name: {
      str: "rail mount",
    },
    description: "An aluminum adapter which allows attaching rail-mounted devices to guns without rails.",

    weight: "36 g",
    dimensions: {
      type: "rectangle",

      length: "4.1 in",
      // * derived from visual reference
      width: "0.8 in",
      // * derived from visual reference
      // * without screws
      height: "13.1 mm",
      // * accounts for the screws, which usually come attached to the mount when the mount is detached
      trim: 0.05,
    },
    longest_side: "4.1 in",

    material: ["aluminum"],

    location: "rail mount",
    install_time: "2 m",
    min_skills: [["gun", 1]],
    add_mod: [["rail", 1]],

    price: "24 USD 95 cent",
    price_postapoc: "1 USD",
  },
  {
    id: "mount/rail/magpul:double",
    "copy-from": "mount/rail/magpul",
    type: "ITEM",
    subtypes: ["GUNMOD"],

    name: {
      str: "double rail mount",
    },
    description: "A pair of aluminum adapters which allow attaching rail-mounted devices to guns without rails.",

    weight: {
      math: [
        { ref: "mount/rail/magpul", key: "weight" },
        { op: "multiply", value: 2 },
      ],
    },
    volume: {
      math: [
        { ref: "mount/rail/magpul", key: "volume" },
        { op: "multiply", value: 2 },
      ],
    },

    add_mod: [["rail", 2]],

    price: {
      math: [
        { ref: "mount/rail/magpul", key: "price" },
        { op: "multiply", value: 2 },
      ],
    },
    price_postapoc: {
      math: [
        { ref: "mount/rail/magpul", key: "price_postapoc" },
        { op: "multiply", value: 2 },
      ],
    },
  },
  {
    id: "mount/rail/magpul:triple",
    "copy-from": "mount/rail/magpul",
    type: "ITEM",
    subtypes: ["GUNMOD"],

    name: {
      str: "triple rail mount",
    },
    description: "A triplet of aluminum adapters which allow attaching rail-mounted devices to guns without rails.",

    weight: {
      math: [
        { ref: "mount/rail/magpul", key: "weight" },
        { op: "multiply", value: 3 },
      ],
    },
    volume: {
      math: [
        { ref: "mount/rail/magpul", key: "volume" },
        { op: "multiply", value: 3 },
      ],
    },

    add_mod: [["rail", 3]],
    // * these gunmods have only two slots for side rails
    // * we count the bottom rail as `underbarrel`
    blacklist_mod: [
      "upper_receiver/ar15/5.56x45mm/16in/aero/mod_4",
      "upper_receiver/ar15/300blk/7.5in/bca/bc15",
      "upper_receiver/ar15/7.62x39mm/16in/radical/pabu16",

      "stock/glock/bt/usw",
    ],

    price: {
      math: [
        { ref: "mount/rail/magpul", key: "price" },
        { op: "multiply", value: 3 },
      ],
    },
    price_postapoc: {
      math: [
        { ref: "mount/rail/magpul", key: "price_postapoc" },
        { op: "multiply", value: 3 },
      ],
    },
  },
]
