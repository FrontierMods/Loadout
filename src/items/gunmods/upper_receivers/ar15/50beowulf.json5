[
  {
    id: "upper_receiver/ar15/50beowulf/10.5in/bca/bc15",
    inherit: "@upper_receiver/ar15/50beowulf",
    type: "ITEM",
    subtypes: ["GUNMOD"],

    /*
        SOURCES
            https://www.bearcreekarsenal.com/127-42-10-5-parkerized-hb-barrel-1-20-twist-pistol-10-handguard-rc.html
     */

    /*
        NOTES
            - handguard length (10 in.) used as reference length for area calculation
     */

    name: {
      str: "10.5″ .50 Beowulf AR-15 upper receiver",
    },
    description: "<upper_receiver/ar15>  <upper_receiver>  <upper_receiver/caliber:50beowulf>  <upper_receiver/barrel:10.5>",
    expand_snippets: true,

    variant_type: "gun",
    variants: [
      {
        from: ["black"],

        name: {
          str: "BCA 10.5″ .50 Beowulf AR-15 upper receiver",
        },
        description: "A complete upper receiver assembly for AR-15-style firearms.  Includes a 10.5-inch barrel chambered in .50 Beowulf, standard-issue internal components, and an M-LOK handguard with most of its upper rail between the start and the end of the handguard missing.",
      },
    ],

    weight: "4.5 lbs",
    dimensions: {
      type: "area",

      area: "34.64 in2",
      length: "1.35 in",
      // * is for the part where the barrel sticks ahead of the handguard
      trim: 0.02,
    },
    longest_side: "17.5 in",
    integral_longest_side: {
      math: [
        { ref: "$", key: "longest_side" },
        {
          op: "subtract",
          value: { ref: "@constants/uppers", key: "length" },
        },
      ],
    },
    barrel_length: "10.5 in",

    // * no slot for bayonet lug because the barrel is not long enough to hold a bayonet
    // * the M-LOK handguard requires mounts
    add_mod: [
      ["brass catcher", 1],
      ["underbarrel mount", 1],
      ["rail mount", 1],
      ["rail", 2],
      ["muzzle", 1],
      ["sights", 1],
    ],

    price: "299.60 USD",
  },
