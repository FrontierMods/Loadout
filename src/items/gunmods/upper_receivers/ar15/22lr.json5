[
  {
    id: "upper_receiver/ar15/22lr/16in/chiappa/m4-22",
    inherit: "@upper_receiver/ar15/22lr",
    type: "ITEM",
    subtypes: ["GUNMOD"],

    /*
        SOURCES
            https://bosqueoutdoors.com/chiappa-m4-22-gen-ii-pro-upper-22lr-16-10rd/

            https://www.midwestgunworks.com/page/mgwi/prod/500-095
                - price
                - length
     */

    name: {
      str: "16″ .22LR AR-15 upper receiver",
    },
    description: "<upper_receiver/ar15>  <upper_receiver>  <upper_receiver/caliber:22lr>  <upper_receiver/barrel:16>",
    expand_snippets: true,

    variant_type: "gun",
    variants: [
      {
        from: ["black"],

        name: {
          str: "Chiappa 16″ .22LR M4-22 Gen II Pro AR-15 upper receiver",
        },
        description: "A complete upper receiver assembly for AR-15-style firearms.  Includes a 16-inch barrel chambered in .22 LR, standard .22 LR internal components, and a quad-rail handguard which leaves a few inches of the barrel exposed.",
      },
    ],

    weight: "4 lbs",
    dimensions: {
      type: "area",

      area: "95028.86 mm2",
      // * we assume it has the same exact width as the KAC handguard on the M4A1 until proven otherwise
      length: "1.35 in",
      // * trim is only for the part where the barrel sticks ahead of the handguard
      trim: 0.075,
    },
    longest_side: "23.6 in",
    integral_longest_side: {
      math: [
        { ref: "$", key: "longest_side" },
        {
          op: "subtract",
          value: { ref: "@constants/uppers", key: "length" },
        },
      ],
    },
    barrel_length: "16 in",

    price: "349 USD",
  },
]
