    expand_snippets: true,

    variant_type: "gun",
    variants: [
      {
        from: ["black"],

        name: {
          str: "BCA 18″ .450 Bushmaster AR-15 upper receiver",
        },
        description: "A complete upper receiver assembly for AR-15-style firearms.  Includes a 18-inch barrel chambered in .450 Bushmaster, standard-issue internal components, and an M-LOK handguard with most of its upper rail between the start and the end of the handguard missing.",
      },
    ],

    weight: "6 lbs",
    dimensions: {
      type: "area",

      area: "42.27 in2",
      length: "1.35 in",
      // * for the part where the barrel sticks ahead of the handguard
      trim: 0.045,
    },
    longest_side: "25 in",
    integral_longest_side: {
