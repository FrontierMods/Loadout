[
  {
    id: "grenade_launcher/underbarrel/lmt/l2b",
    inherit: ["@underbarrel/weapon"],
    "copy-from": "underbarrel_base",
    type: "ITEM",
    subtypes: ["GUN", "GUNMOD"],

    /*
        SOURCES
            https://lmtdefense.com/product/9-rail-mounted-m203/

            https://www.capitolarmory.com/lmt-l2b-destructive-device.html
                - price

            https://www.airsoft.ro/airsoft-guns/mass-destruction/launchers-grenade-launchers/grenade-launcher-model-m203-for-m4-m16
                - external diameter reference
     */

    name: {
      str_sp: "underbarrel grenade launcher",
    },
    description: "A long tube with a trigger at the end.  The tube can hold a single 40mm grenade, which it can fire at the target when mounted onto the underbarrel of a gun or onto a dedicated standalone frame.",

    variant_type: "gun",
    variants: [
      {
        from: ["black"],

        name: {
          str: "LMT L2B 40mm grenade launcher",
        },
        description: "A Picatinny-mounted launcher for 40mm grenades.  Measuring at 12.5″, it is half an inch longer as its military cousin, the M203A1, and 2.5″ shorter than the M203.  Can be mounted onto any gun with a long-enough bottom rail.  Alternatively, it can be mounted onto a dedicated frame in order to be used in a stand-alone configuration, without requiring a gun.",
      },
    ],

    material: ["steel", "plastic"],

    faults: ["fault_gun_blackpowder", "fault_gun_dirt"],

    weight: "2.2 lbs",
    dimensions: {
      type: "cylinder",

      length: "12.5 in",
      diameter: "45 mm",
      // * no trim, assuming the flat parts fill out the 'diameter'
    },
    longest_side: "12.5 in",

    install_time: "2 m",
    blacklist_mod: [
      "knife_combat_army",
      "knife_combat",
      "enfield_bayonet",
      "knife_combat_marine",
      "makeshift_bayonet",
      "sword_bayonet",
    ],
    min_skills: [
      ["weapon", 1],
      ["launcher", 1],
    ],

    skill: "launcher",
    ammo: "40x46mm",

    barrel_length: "229 mm",
    dispersion: 300,
    durability: 10,

    blackpowder_tolerance: 60,
    clip_size: 1,

    flags: ["NEVER_JAMS", "RELOAD_EJECT"],

    pocket_data: [
      {
        pocket_type: "MAGAZINE",
        ammo_restriction: {
          "40x46mm": 1,
        },
      },
    ],

    price: "1979 USD",
    price_postapoc: "10 USD",
  },

  {
    id: "grenade_launcher/underbarrel/hk/m320",
    inherit: ["@underbarrel/weapon"],
    "copy-from": "underbarrel_base",
    type: "ITEM",
    subtypes: ["GUN", "GUNMOD"],

    /*
        SOURCES
            TM 3-22.31
                - dimensions
                - weight
                - barrel length

            https://www.thefirearmblog.com/blog/2008/12/05/40mm-m320-grenade-launcher-will-be-replace-m203-next-year/
                - price
     */

    /*
        NOTES
            - even H&K US site says it can be installed onto Picatinny rail
            > https://hk-usa.com/hk-models/ag-ceglm/
            - as such, and for reasons of simplicity, we assume this item to be Picatinny-capable, as well

            - day/night sight requires 1× DL123A battery to operate
            - the sight also features an iron sight
     */

    name: {
      str_sp: "M320 grenade launcher",
    },
    description: "A long tube with a trigger and a grip on one end, and a foregrip on the other.  The tube can hold a single 40mm grenade, which it can fire at the target when mounted onto the underbarrel of a gun or in a standalone configuration with a dedicated buttstock.",

    variant_type: "gun",
    variants: [
      {
        from: ["black"],

        name: {
          str: "M320 grenade launcher",
        },
        description: "A Picatinny-mounted launcher for 40mm grenades.  This model replaces M203, and comes with a modern sight and a foregrip.  Can be mounted onto any gun with a long-enough bottom rail.  Alternatively, it can be connected with a dedicated buttstock in order to be used in a stand-alone configuration, without requiring a gun.",
      },
    ],

    weight: {
      math: [
        // * launcher itself
        "5 lbs",
        {
          op: "add",
          // * day/night sight
          value: "15.5 oz",
        },
      ],
    },
    dimensions: {
      // * LAUNCHER
      type: "rectangle",

      // * from visual reference
      length: "11.18 in",
      // * assumed based on visual comparison
      width: "2.56 in",
      // * from visual reference
      height: "6.38 in",
      trim: 0.5,
    },
    longest_side: "11.18 in",

    material: ["steel", "plastic"],

    install_time: "5 m",
    blacklist_mod: [
      "knife_combat_army",
      "knife_combat",
      "enfield_bayonet",
      "knife_combat_marine",
      "makeshift_bayonet",
      "sword_bayonet",
    ],
    min_skills: [
      ["weapon", 1],
      ["launcher", 1],
    ],
    // * while unwieldy as a way to grip the gun at the front, it comes with a pistol grip and a foregrip
    handling_modifier: 5,

    skill: "launcher",
    ammo: "40x46mm",

    barrel_length: "215 mm",
    dispersion: 270,
    durability: 10,

    blackpowder_tolerance: 60,
    clip_size: 1,
    faults: [{ fault: "fault_gun_blackpowder" }, { fault: "fault_gun_dirt" }],

    pocket_data: [
      {
        pocket_type: "MAGAZINE",
        ammo_restriction: {
          "40x46mm": 1,
        },
      },
    ],

    flags: ["NEVER_JAMS", "RELOAD_EJECT"],

    price: "3500 USD",
    price_postapoc: "10 USD",
  },
]
