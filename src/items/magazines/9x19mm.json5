      str: "Glock 9x19mm 50-round drum magazine",
    },
    description: "Made for Glock pistols, this drum magazine holds 50 rounds.",

    weight: "17.3 oz",
    dimensions: {
      type: "area",

      area: "20.82 in2",
      length: "2.61 in",
      // * trim is for the tower, which does not stretch for the entirety of the magazine's width (which is that of the drum)
      trim: 0.3,
    },
    // * Feret distance
    longest_side: "9.11 in",

    material: ["plastic"],

    reload_time: 140,
    // * reviews report it feeding without a malfunction
