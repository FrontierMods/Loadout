[
  {
    id: "magazine/magpul/pmag/10",
    inherit: ["@magazine/5.56x45mm", "@magazine/compact"],
    type: "ITEM",
    subtypes: ["MAGAZINE"],

    /*
      SOURCES
        https://magpul.com/pmag-10-ar-m4-gen-m3.html
    */

    name: {
      str: "PMAG STANAG 10-round magazine",
    },
    description: "A polymer magazine for the STANAG-compatible rifles.  Has an elaborate texture that should make it easier to handle.  Its low capacity becomes an asset for cases of hunting or recreational shooting.",

    variant_type: "gun",
    variants: [
      {
        id: "black",

        name: {
          str: "Magpul PMAG 10-round magazine",
        },
        description: "A polymer magazine for 5.56mm and .300 Blackout rifles.  Its texture is intended to make it handle better than conventional aluminum magazines.  Intended for hunting and recreational shooting, as its low capacity means less ammunition to weigh you down.  Its reduced capacity also makes it the only legal Magpul magazine in the state of Massachusetts.  <variant:black>",
        expand_snippets: true,
        weight: 1,
      },
    ],

    /*
      WEIGHT
        manufacturer's website claims 3 oz
        RifleMags.co.uk (https://riflemags.co.uk/magpul-pmag-10-round-ar-m4-gen-m3-5-56x45-223-magazine/): 101 g
        e-militaria (https://e-militaria.eu/24117-magpul-pmag-10-arm4-gen-m3-magazine-black-mag559-blk-873750006192.html): 84 g, not far off from the original claim
        Bushmaster (https://www.bushmaster.com/shop/magazines/magpul-pmag-10-ar-m4-gen-m3-5-56x45-black/): 0.2 lbs = 90.72 g in the description, but 3 oz in the stats
        Smith & Edwards (https://www.smithandedwards.com/products/magpul--pmag-ar-m4-gen3-10-round-magazine-8027.html): 0.23 lbs = 104.33 g
        we stick with the Magpul's value until a trustworthy review either confirms or challenges it
    */
    weight: "3 oz",
    dimensions: {
      type: "area",

      area: "8.65 in2",
      length: "0.87 in",
    },
    longest_side: "4.19 in",

    material: ["plastic"],

    pocket_data: [
      {
        pocket_type: "MAGAZINE",

        rigid: true,

        allowed_speedloaders: ["clip223_10rd"],

        ammo_restriction: {
          "223": 10,
          "300blk": 10,
        },
      },
    ],

    price: "14 USD 95 cent",
    price_postapoc: { utility: "low", longevity: "high", scarcity: "none" },
  },
  {
