[
  {
    id: "magazine/baseplate/colt/stanag",
    inherit: "@magmod",
    type: "ITEM",

    /*
      SOURCES
        M4 Technical Data Package
    */

    name: {
      str: "STANAG magazine baseplate",
    },
    description: "A thin aluminum plate, usually sitting at the bottom of a magazine.  Can be attached to aluminum STANAG magazine bodies to turn them into usable magazines.",

    variant_type: "gun",
    variants: [
      {
        id: "steel",

        name: {
          str: "STANAG magazine baseplate",
        },
        description: "A thin aluminum plate with a curved edge.  When installed, prevents the magazine spring from falling out of the magazine.  Can be installed onto a relevant magazine body in order to make it a usable magazine.  <variant:steel>",
        expand_snippets: true,
        weight: 1,
      },
    ],

    // * precalculated from volume and density; sources are scarce
    // TODO: calculate properly
    weight: "7.5 g",
    dimensions: [
      {
        // * main plate
        type: "rectangle",

        length: "2.31 in",
        width: "0.786 in",
        height: "0.04 in",
        // * a mixed trim for two rounded corners countered by the 0.07-inch teeth on the opposite end
        trim: -0.025,
      },
      {
        // * tongue
        type: "rectangle",

        length: "0.15 in",
        width: "0.43 in",
        height: "0.04 in",
        // * two rounded corners
        trim: 0.025,
      },
    ],
    longest_side: "2.59 in",

    material: ["aluminum"],

    price: "1 cent",
    price_postapoc: { utility: "none", longevity: "medium", scarcity: "none" },
  },
  {
    id: "magazine/baseplate/magpul/pmag",
    inherit: "@magmod",
    type: "ITEM",

    /*
      SOURCES
        https://www.amazon.com/Magpul-PMAG-Floor-Plate-Pack/dp/B07K55YYHX
          - weight reference

        https://magpul.com/pmag-30-ar-m4-gen-m3.html
          - visual reference
    */

    /*
      NOTES
        - the base plate is said to be 69 mm in length
          > https://www.haho.online/post/review-taran-tactical-innovations-pmag-extension
    */

    name: {
      str: "PMAG magazine baseplate",
    },
    description: "A thin plastic plate, usually sitting at the bottom of a magazine. Can be attached to PMAG magazine bodies to turn them into usable magazines.",

    variant_type: "gun",
    variants: [
      {
        id: "black",

        name: {
          str: "Magpul PMAG baseplate",
        },
        description: "A thin plastic plate with curved edges.  When installed, prevents the magazine spring from falling out of the magazine.  Can be installed onto a relevant magazine body in order to make it a usable magazine.  <variant:black>",
        expand_snippets: true,
        weight: 1,
      },
    ],

    // * we assume the listed value is given per 5 plates in the package
    weight: "9 g 979 mg",
    dimensions: {
      type: "area",

      area: "0.75 in2",
      length: "0.87 in",
      trim: 0.7,
    },
    longest_side: "2.63 in",

    material: ["plastic"],

    price: "5 cent",
    price_postapoc: { utility: "none", longevity: "medium", scarcity: "none" },
  },
  {
    id: "magazine/baseplate/magpul/ranger",
    inherit: "@magmod",
    type: "ITEM",

    /*
      SOURCES
        https://magpul.com/pmagrangerplate-genm35-56x45-3pack.html

        https://www.armamat.ch/en-ch/p/pmag-gen-m3-ranger-plate-3-pack-103802/
        https://www.varusteleka.com/en/product/magpul-pmag-ranger-plate-ak-akm-3-pack/68659
          - weight

        https://www.armamat.com/en/p/usgi-ranger-floorplate-3-pack-102951/
          - materials
    */

    name: {
      str: "PMAG magazine ranger plate",
    },
    description: "A plastic loop skewed to one side, usually sitting at the bottom of a magazine.  Can be attached to PMAG magazine bodies to turn them into usable magazines with a hook to hang them off carabiners with.",

    variant_type: "gun",
    variants: [
      {
        id: "black",

        name: {
          str: "Magpul PMAG ranger plate",
        },
        description: "A plastic loop with curved edges and skewed to one side.  Can be attached to PMAG magazines to allow the resulting usable magazines to hang off carabiners and other hooks.  Note: PMAG-specific plates do not fit conventional STANAG magazines.  <variant:black>",
        expand_snippets: true,
        weight: 1,
      },
    ],

    /*
      WEIGHT
        two sources state roughly the same value between two different models of ranger plates: 52 g / 3 = 17.33 g, or 0.6 oz = 17.01 g
        even though this references two different models, we assume the difference between the two is negligible, and thus use the latter value for all ranger plates
    */
    weight: "0.6 oz",
    dimensions: {
      type: "area",

      area: "1.52 in2",
      length: "0.87 in",
      trim: 0.25,
    },
    // * Feret distance
    longest_side: "2.65 in",

    material: ["stainless_steel", "rubber"],

    // * we assume the price is for three pieces
    price: "8 USD 33 cent",
    price_postapoc: { utility: "none", longevity: "medium", scarcity: "none" },
  },
  {
    id: "magazine/baseplate/magpul/ranger/usgi",
    inherit: "@magmod",
    type: "ITEM",

    /*
      SOURCES
        https://magpul.com/rangerplate-usgi5-56x45-3pack.html

        https://www.armamat.com/en/p/usgi-ranger-floorplate-3-pack-102951/
          - weight

        https://tacticalproductscanada.com/products/mpimag020b-magpul-ranger-floor-plate-5-56-nato-3-pack-mag020
          - visual reference
    */

    name: {
      str: "STANAG magazine ranger plate",
    },
    description: "A plastic loop skewed to one side, usually sitting at the bottom of a magazine.  Can be attached to STANAG magazine bodies to turn them into usable magazines with a hook to hang them off carabiners with.",

    variant_type: "gun",
    variants: [
      {
        id: "black",

        name: {
          str: "Magpul USGI ranger plate",
        },
        description: "A plastic loop with curved edges and skewed to one side.  Can be attached to conventional STANAG magazines to allow the resulting usable magazines to hang off carabiners and other hooks.  Note: STANAG-specific plates do not fit PMAGs or other types of 5.56mm magazines.  <variant:black>",
        expand_snippets: true,
        weight: 1,
      },
    ],

    // * we assume the listed value is given per 3 plates in the package
    // * Big Tex Ordnance reports total weight of 136 g in oz
    // > https://www.bigtexordnance.com/product/magpul-ranger-plate-usgi-5-56x45-3-pack-black-odg-fde/
    weight: "19 g 666 mg",
    dimensions: {
      type: "area",

      area: "2.34 in2",
      length: "0.87 in",
      trim: 0.25,
    },
    longest_side: "2.48 in",

    material: ["stainless_steel", "rubber"],

    // * we assume the price is for three pieces
    price: "8 USD 33 cent",
    price_postapoc: { utility: "none", longevity: "medium", scarcity: "none" },
  },
  {
    id: "magazine/baseplate/taran/extended/pmag",
    inherit: "@magmod",
    type: "ITEM",

    /*
      SOURCES
        https://tarantacticalinnovations.com/5-6-base-pad-for-ar-15-223-30-40-round-pmag-magazines/

        https://www.haho.online/post/review-taran-tactical-innovations-pmag-extension
          - dimensions
          - weight
    */

    /*
      NOTES
        - there is a lot more colors of the plate, but we only implement the black one for the sake of simplicity for now
        - advertised as +5 on 30-round magazines, +6 on 40-round magazines
        - according to The Mag Shack, the extension is compatible with the 20-, 30-, and 40-round PMAGs, but not 10-rounders
          - it's also not compatible with the .300 Blackout-exclusive PMAGs
          > https://themagshack.com/shop/accessories/magazine-extensions/taran-tactical-magpul-pmag-ar-15-223-5-56-5-6-extension/
    */

    name: {
      str: "PMAG magazine extension",
    },
    description: "A thick aluminum cup with the manufacturer's logo stamped on the side.  Can be attached to PMAG magazine bodies to turn them into usable magazines with extended capacity.  30-round magazines get 5 extra rounds, while 40-round ones get 6.",

    variant_type: "gun",
    variants: [
      {
        id: "black",

        name: {
          str: "Taran Tactical PMAG +5/+6 magazine extension",
        },
        description: "An milled piece of aluminum with the Taran logo on the side.  Can be attached to PMAG bodies to increase their capacity: +5 for 30-round ones, +6 for 40-rounders.  <variant:black>",
        expand_snippets: true,
        weight: 1,
      },
    ],

    weight: "59.5 g",
    dimensions: {
      type: "rectangle",

      length: "73 mm",
      width: "29 mm",
      height: "25 mm",
      trim: 0.0625,
    },

    material: ["aluminum"],

    price: "43 USD 99 cent",
    price_postapoc: { utility: "none", longevity: "high", scarcity: "medium" },
  },
]
