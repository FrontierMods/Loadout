[
  {
    id: "robofac_gun",
    inherit: "robofac_gun",
    // * preserve inheritance for in-game display
    "copy-from": "robofac_gun",
    type: "ITEM",
    subtypes: ["GUN"],

    patch: [
      { op: "drop", key: "default_mods", value: "hybrid_sight_4x" },

      { op: "push", key: "default_mods", value: "sight/trijicon/ta01" },
      {
        op: "push",
        key: "default_mods",
        value: "sight_mount/rmr/trijicon/rm35",
      },
      { op: "push", key: "default_mods", value: "sight/trijicon/rmr" },
    ],
  },
  {
    id: "m110a1",
    "copy-from": "m110a1",
    type: "ITEM",
    subtypes: ["GUN"],

    name: { str: "M110A1" },

    // * keep stock on because a rifle, even out of use, would most likely be equipped with one
    default_mods: ["adjustable_stock"],
  },
  {
    id: "modular_m16_auto_rifle",
    "copy-from": "modular_m16_auto_rifle",
    type: "ITEM",
    subtypes: ["GUN"],

    name: { ref: "modular_m16_auto_rifle", scope: "dda", key: "name" },

    variant_type: "gun",
    variants: { ref: "modular_m16_auto_rifle", scope: "dda", key: "variants" },

    // * removed `adjustable_stock`: the M16A3 has a fixed stock
    default_mods: ["upper_receiver/ar15/5.56x45mm/20in/colt/m16a3"],
  },
  {
    id: "modular_m16a4",
    "copy-from": "modular_m16a4",
    type: "ITEM",
    subtypes: ["GUN"],

    name: { ref: "modular_m16a4", scope: "dda", key: "name" },

    variant_type: "gun",
    variants: { ref: "modular_m16a4", scope: "dda", key: "variants" },

    // * removed `adjustable_stock`: the M16A4 has a fixed stock
    default_mods: ["upper_receiver/ar15/5.56x45mm/20in/colt/m16a4"],
  },
  {
    id: "modular_m27_assault_rifle",
    "copy-from": "modular_m27_assault_rifle",
    type: "ITEM",
    subtypes: ["GUN"],

    name: { ref: "modular_m27_assault_rifle", scope: "dda", key: "name" },

    variant_type: "gun",
    variants: {
      ref: "modular_m27_assault_rifle",
      scope: "dda",
      key: "variants",
    },

    // * this is clearly not the right upper for this gun, but in the absence of any information about the real one, this will have to do
    // * H&K has a 16.5-in. upper under the label of MR556, some models of which have Picatinny railing
    default_mods: ["upper_receiver/ar15/5.56x45mm/16in/aero/mod_4"],
  },
  {
    id: "scar_h_mk20",
    inherit: "scar_h_mk20",
    "copy-from": "scar_h_mk20",
    type: "ITEM",
    subtypes: ["GUN"],

    patch: [
      { op: "drop", key: "default_mods", value: "rifle_scope_high_end_mount" },

      // TODO: replace with an appropriate sight
      { op: "push", key: "default_mods", value: "sight_mount/30mm/aero" },
      {
        op: "push",
        key: "default_mods",
        value: "sight/trijicon/tenmile/3-18x",
      },
    ],
  },
]
