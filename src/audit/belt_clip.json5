    extend: { valid_mod_locations: [["belt clip", 1]] },
  },
  {
    id: "m1911_10",
    "copy-from": "m1911_10",
    type: "GUN",

    name: {
      str: "Colt Delta Elite pistol",
    },

    variant_type: "gun",
    variants: [
      {
        id: "m1911_10",
        name: {
          str: "Colt Delta Elite pistol",
        },
        description: "A modernized, match-grade variant of the venerable M1911 chambered in hard-hitting 10mm Auto.  Early variants were known to crack frames; modern 1911s, like this one, are slotted to prevent such crack formation.",
      },
    ],

    extend: { valid_mod_locations: [["belt clip", 1]] },
  },
  {
    id: "glock_29",
    "copy-from": "glock_29",
    type: "GUN",

    name: {
      str: "compact Glock pistol",
    },

    variant_type: "gun",
    variants: [
      {
        id: "glock_29",
        name: {
          str: "Glock 29 pistol",
        },
        description: "A modestly sized version of the highly successful Glock, chambered in hard-hitting 10mm Auto.  It is easy to carry because of its small size, but also recoils fiercely.",
      },
    ],

    extend: { valid_mod_locations: [["belt clip", 1]] },
  },
  {
    id: "m18",
    "copy-from": "m18",
    type: "GUN",

    name: {
      str: "compact service handgun",
    },

    variant_type: "gun",
    variants: [
      {
        id: "m18",
        name: {
          str: "M18 pistol",
        },
        description: "The M18 is a compact, semi-automatic, short recoil operated pistol derived from the SIG Sauer P320 Carry, used by US Armed Forces.  Practically the same as its big brother, the M17, in every respect, the M18 features a moderately shorter slide and barrel which terminates at the end of the frame rather than extending partway beyond it like the M17.",
      },
    ],

    extend: { valid_mod_locations: [["belt clip", 1]] },
  },
