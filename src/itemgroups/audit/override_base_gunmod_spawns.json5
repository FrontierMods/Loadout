[
  {
    id: "gunmod_common",
    inherit: "gunmod_common",
    type: "item_group",

    patch: [
      {
        op: "drop",
        key: "items",
        filter: [{ item: "improve_sights" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "masterkey" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "sword_bayonet" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "match_trigger" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "shoulder_strap_simple" }],
      },

      {
        op: "drop",
        key: "items",
        filter: [{ item: "muzzle_brake" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "compensator" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "choke" }],
      },
      {
        op: "push",
        key: "items",
        value: { group: "muzzle_devices/all", prob: 30 },
      },

      {
        op: "drop",
        key: "items",
        filter: [{ item: "rifle_scope" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "red_dot_sight" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "offset_sights" }],
      },
      {
        op: "push",
        key: "items",
        value: { group: "sights/all", prob: 50 },
      },

      {
        op: "replace",
        key: "items",
        filter: [{ item: "rail_laser_sight" }],
        value: { group: "laser_sights/bottom_rail", prob: 40 },
      },

      {
        op: "push",
        key: "items",
        value: { group: "foregrips/angled", prob: 40 },
      },
      {
        op: "push",
        key: "items",
        value: { group: "foregrips/tall", prob: 30 },
      },
    ],
  },

  {
    id: "gunmod_rare",
    inherit: "gunmod_rare",
    type: "item_group",

    patch: [
      // * stocks may not spawn until a proper replacement mechanism is implemented
      {
        op: "drop",
        key: "items",
        filter: [{ item: "adjustable_stock" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "recoil_stock" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "folding_stock" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "high_end_folding_stock" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "tail_hook_stock" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "butt_hook" }],
      },

      {
        op: "drop",
        key: "items",
        filter: [{ item: "barrel_ported" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "pistol_bayonet" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "pistol_bayonet" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "retool_ar15_300blk" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "modern_handguard" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "bipod_handguard" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "u_shotgun" }],
      },

      {
        op: "drop",
        key: "items",
        filter: [{ item: "suppressor" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "suppressor_compact" }],
      },

      // * dropping in favor of the sights group in `gunmod_common`
      {
        op: "drop",
        key: "items",
        filter: [{ item: "hybrid_sight_4x" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "rifle_scope_high_end_mount" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "rifle_scope_high_end_mount" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "holo_sight" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "holo_magnifier" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "acog_scope" }],
      },
      {
        op: "drop",
        key: "items",
        filter: [{ item: "pistol_scope" }],
      },

      {
        op: "drop",
        key: "items",
        filter: [{ item: "grip" }],
      },
      {
        op: "push",
        key: "items",
        value: [{ group: "foregrips/short", prob: 40 }],
      },
      {
        op: "push",
        key: "items",
        value: [{ group: "foregrips/tiny", prob: 30 }],
      },

      {
        op: "drop",
        key: "items",
        filter: [{ item: "arredondo_chute" }],
      },
      {
        op: "push",
        key: "items",
        value: [{ group: "chutes", prob: 40 }],
      },

      {
        op: "drop",
        key: "items",
        filter: [{ item: "laser_sight" }],
      },
      {
        op: "push",
        key: "items",
        value: [{ group: "laser_sights/rail:civilian", prob: 40 }],
      },
      {
        op: "push",
        key: "items",
        value: [{ group: "laser_sights/rail:military", prob: 5 }],
      },
    ],
  },

  {
    id: "gunmod_milspec",
    inherit: "gunmod_milspec",
    type: "item_group",

    "//changes": [
      "removed `m203`: the model we use in Loadout currently is not milspec",
      "replaced `holo_sight` (currently EOTech EXPS3) with EOTech 553: 553 is actually used by SOCOM and has trickled down to Army grunts eventually",
      "added military laser sights group",
    ],

    patch: [
      // * only the Marines have bayonets as part of their doctrine
      // * even then, the bayonets are knife-size, not sword-size
      {
        op: "drop",
        key: "items",
        filter: [{ item: "sword_bayonet" }],
      },

      // * replaced by M26-MASS, which already spawns in this group
      {
        op: "drop",
        key: "items",
        filter: [{ item: "masterkey" }],
      },

      {
        op: "replace",
        key: "items",
        filter: [{ item: "holo_sight" }],
        value: { item: "sight/eotech/553", prob: 100 },
      },

      {
        op: "push",
        key: "items",
        value: [{ group: "laser_sights/rail:military", prob: 30 }],
      },
      {
        op: "push",
        key: "items",
        value: [{ group: "sights:military", prob: 50 }],
      },
    ],
  },
]
